# Elite Dashboard environment configuration
# Copy this file to .env and fill in real values before deploying.

# Required in production: a long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-me-to-a-long-random-secret

# Required in production: PostgreSQL connection string
# Example: postgresql://myuser:mypassword@db.example.com:5432/elite_dashboard
DATABASE_URL=postgresql://username:password@localhost:5432/elite_dashboard

# Optional: set to "production" to enforce SECRET_KEY / DATABASE_URL checks
# FLASK_ENV=production
