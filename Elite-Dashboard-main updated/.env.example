# Elite Dashboard Environment Configuration
# Copy this file to .env and fill in your values before running locally.
# .env is ignored by Git and will NOT be committed.

# Flask secret key for session security.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL database URL.
# Format: postgresql://username:password@host:5432/database_name
# If left empty, the app falls back to a local SQLite database for development.
DATABASE_URL=

# Admin account password used by the seed-admin CLI command.
# If unset in development, defaults to "Admin@123".
# Required in production.
ADMIN_PASSWORD=Admin@123

# Optional: set to "production" to enable production config checks.
# APP_ENV=production

# Optional: timezone used for Elite Sprint sessions (default: Asia/Kolkata).
# ELITE_TIMEZONE=Asia/Kolkata
